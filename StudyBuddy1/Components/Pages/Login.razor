@page "/login"

<h2 class="text-2xl font-bold mb-4">Login</h2>

<div class="max-w-md mx-auto bg-white p-6 rounded shadow">
    <label>Email</label>
    <input class="w-full border rounded p-2 mb-3" @bind="email" placeholder="Enter email" />

    <label>Password</label>
    <input type="password" class="w-full border rounded p-2 mb-4" @bind="password" placeholder="Enter password" />

    <button class="bg-blue-600 text-white px-4 py-2 rounded" @onclick="LoginUser">Login</button>

    <p class="mt-4 text-sm text-gray-600">
        Don’t have an account? <a href="/signup" class="text-blue-600 hover:underline">Sign Up</a>
    </p>
</div>

@code {
    private string email = "";
    private string password = "";

    void LoginUser()
    {
        Console.WriteLine($"Login attempt: {email} / {password}");
    }
}
