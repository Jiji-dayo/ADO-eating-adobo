@page "/view-quizzes"

<PageTitle>View Quizzes</PageTitle>

<div class="nav-bar">
    <div class="nav-left">
        <div class="profile-icon">👤</div>
        <span class="profile-text">Profile</span>
    </div>
    <div class="nav-links">
        <a href="#">Dashboard</a>
        <a href="/view-quizzes" class="active">View Quizzes</a>
        <a href="#">View Leaderboard</a>
        <a href="#">Create A Quiz</a>
    </div>
    <button class="logout-btn">Log out</button>
</div>

<div class="main-container">
    <h4>Quizzes you created:</h4>

    <div class="quiz-grid">
        @foreach (var quiz in quizzes)
        {
            <div class="quiz-card">
                <div class="quiz-header">@quiz.Title</div>
                <div class="quiz-body">@quiz.Description</div>
                <div class="quiz-actions">
                    <button class="btn edit">Edit</button>
                    <button class="btn delete">Delete</button>
                    <button class="btn open" @onclick="() => OpenQuiz(quiz.Id)">Open Quiz</button>
                </div>
                <div class="quiz-footer">
                    <span>View quiz takers</span>
                    <span># Number of items</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Quiz> quizzes = new()
    {
        new Quiz { Id = 1, Title = "Quiz template #1", Description = "quiz overview... quiz overview... quiz overview..." },
        new Quiz { Id = 2, Title = "Quiz template #2", Description = "quiz overview... quiz overview... quiz overview..." },
        new Quiz { Id = 3, Title = "Quiz template #3", Description = "quiz overview... quiz overview... quiz overview..." },
        new Quiz { Id = 4, Title = "Quiz template #4", Description = "quiz overview... quiz overview... quiz overview..." },
        new Quiz { Id = 5, Title = "Quiz template #5", Description = "quiz overview... quiz overview... quiz overview..." }
    };

    private void OpenQuiz(int id)
    {
        Navigation.NavigateTo($"/open-quiz/{id}");
    }

    [Inject] NavigationManager Navigation { get; set; } = default!;

    public class Quiz
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
    }
}
