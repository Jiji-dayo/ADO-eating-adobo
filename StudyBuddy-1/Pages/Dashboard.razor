@page "/dashboard"
@using StudyBuddy.Data.Models
@inject AuthenticationService AuthService

<h3>Dashboard</h3>

@if (user == null)
{
    <p>Loading...</p>
}
else
{
    <div class="dashboard-content">
        <h4>Welcome, @user.Username!</h4>
        <p>Your dashboard is the central hub for managing your activities.</p>
        <nav>
            <ul>
                <li><NavLink href="/profile">Profile</NavLink></li>
                <li><NavLink href="/settings">Settings</NavLink></li>
                <li><NavLink href="/logout">Logout</NavLink></li>
            </ul>
        </nav>
    </div>
}

@code {
    private User user;

    protected override async Task OnInitializedAsync()
    {
        user = await AuthService.GetCurrentUserAsync();
    }
}